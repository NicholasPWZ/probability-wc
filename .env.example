# ================================================================
# Compubot - exemplo de variaveis de ambiente. Copie para .env e
# preencha (o .env real e gitignored - nunca commitar segredos).
# IMPORTANTE: nada de comentario na MESMA linha do valor (KEY=valor).
# ================================================================

# --- App (obrigatorio) ---
# APP_PASSWORD: senha unica para entrar no app
# SECRET_KEY: string aleatoria longa (assina o cookie de sessao)
# FERNET_KEY: opcional; vazio = gera/usa .cache/fernet.key
APP_PASSWORD=
SECRET_KEY=
FERNET_KEY=

# --- Empresas VENDEDORAS no PDF do orcamento (ate 3; todos os campos opcionais) ---
# O vendedor escolhe na tela qual empresa esta vendendo (seletor aparece com 2+); o cabecalho do PDF
# muda. E sobre quem VENDE (nao o cliente). Preencha COMPANY1_* e COMPANY2_*. Uma empresa pode nao
# ter endereco/telefone - deixe em branco. O nome/CNPJ/endereco ficam editaveis por orcamento.
# COMPANY1_NAME=CompuJob Informatica LTDA
# COMPANY1_CNPJ=00.000.000/0001-00
# COMPANY1_ADDRESS=Rua Exemplo, 123 - Centro - Cidade/UF
# COMPANY1_PHONE=(11) 3333-3333
# COMPANY1_MOBILE=(11) 99999-9999
# COMPANY2_NAME=Outra Empresa ME
# COMPANY2_CNPJ=11.111.111/0001-11
# COMPANY2_MOBILE=(11) 98888-8888
#
# Compatibilidade: se voce so tiver o COMPANY_* antigo (sem numero), ele vira a empresa unica.
# COMPANY_NAME=CompuJob
# COMPANY_CNPJ=00.000.000/0001-00
# COMPANY_ADDRESS=Rua Exemplo, 123 - Centro - Cidade/UF
# COMPANY_PHONE=(11) 3333-3333
# COMPANY_MOBILE=(11) 99999-9999

# --- Comportamento (opcional; descomente p/ sobrescrever) ---
# CACHE_DIR=.cache
# SEARCH_PAGES=2
# SEARCH_TTL=120
# REQUEST_TIMEOUT=40
# REQUEST_TIMEOUT_OVERRIDES=braile:60,agis:50   # timeout por loja (lojas lentas)
# KEEPALIVE_MINUTES=12
# KEEPALIVE_OVERRIDES=braile:4
# KEEPALIVE_QUIET_START=20      # hora (Brasilia) em que o keepalive PAUSA (economia noturna)
# KEEPALIVE_QUIET_END=6         # hora em que retoma (start==end desativa a janela)
# KEEPALIVE_QUIET_KEEP_ALIVE=agis   # fornecedores com ping barato mesmo de madrugada (nao auto-relogam)
# SEARCH_FILTER=true
# AUTOLOGIN_ENABLED=true
# AUTOLOGIN_HEADLESS=

# --- Credenciais de login por fornecedor (auto-login via Camoufox) ---
# Formato: <CHAVE>_USER / <CHAVE>_PASS. So funciona p/ fornecedores com
# receita em app/autologin.py (agis, pauta, mazer, digimacro, multimarcas, braile).
AGIS_USER=
AGIS_PASS=
PAUTA_USER=
PAUTA_PASS=
MAZER_USER=
MAZER_PASS=
DIGIMACRO_USER=
DIGIMACRO_PASS=
MULTIMARCAS_USER=
MULTIMARCAS_PASS=
BRAILE_USER=
BRAILE_PASS=
