# ================================================================
# Compubot - exemplo de variaveis de ambiente. Copie para .env e
# preencha (o .env real e gitignored - nunca commitar segredos).
# ================================================================

# --- App (obrigatorio) ---
APP_PASSWORD=            # senha unica para entrar no app
SECRET_KEY=             # string aleatoria longa (assina o cookie de sessao)
FERNET_KEY=             # opcional: chave Fernet p/ cifrar tokens; vazio = gera em .cache/fernet.key

# --- Comportamento (opcional) ---
# CACHE_DIR=.cache
# SEARCH_TTL=120                # cache de (fornecedor, busca) em segundos
# REQUEST_TIMEOUT=25            # timeout por requisicao de scraping
# KEEPALIVE_MINUTES=12          # ping de fundo p/ manter sessoes vivas (0 desliga)
# KEEPALIVE_OVERRIDES=braile:4  # intervalo por fornecedor "chave:min,chave:min"
# SEARCH_FILTER=true            # descarta resultados que nao batem com o termo
# AUTOLOGIN_ENABLED=true        # re-loga via Camoufox quando a sessao expira
# AUTOLOGIN_HEADLESS=           # ""=auto (virtual no Linux); true=headless nativo; false=janela

# --- Credenciais de login por fornecedor (auto-login via Camoufox) ---
# Formato: <CHAVE>_USER / <CHAVE>_PASS. So funciona p/ fornecedores com
# receita em app/autologin.py (agis, pauta, mazer, digimacro, multimarcas, braile).
AGIS_USER=
AGIS_PASS=
PAUTA_USER=          # pauta: usuario = CNPJ
PAUTA_PASS=
MAZER_USER=
MAZER_PASS=
DIGIMACRO_USER=
DIGIMACRO_PASS=
MULTIMARCAS_USER=
MULTIMARCAS_PASS=
BRAILE_USER=
BRAILE_PASS=
